# Copy to .env on the Pi Zero and fill in. Never commit the real .env.
GATEWAY_MODE=sniff
MQTT_HOST=localhost
MQTT_PORT=1883
MQTT_USERNAME=
MQTT_PASSWORD=

# sniff mode
RTL433_BINARY=rtl_433
RTL433_FREQ_HZ=433920000
RTL433_SAMPLE_RATE_HZ=250000
RAW_SNIFF_ENABLED=1
RAW_SNIFF_BAND_LABEL=433.92MHz
# Set only if you have a FIFO fed by rtl_sdr/rtl_power for raw spectrum sniffing.
RAW_SNIFF_FIFO_PATH=

# simulate mode
SIM_TPMS_INTERVAL_S=4.0
SIM_SNIFF_INTERVAL_S=2.0
SIM_BEACON_INTERVAL_S=10.0
SIM_VEHICLE_ID=sim-vehicle-01

LOG_LEVEL=INFO
